# ==========================================
# Directus CMS Environment Configuration for cPanel
# ==========================================

# Server Settings
HOST="0.0.0.0"
PORT="8055"
PUBLIC_URL="https://cms.bskbd.org"

# Database Configuration (MySQL on cPanel)
DB_CLIENT="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="bskbd_new"
DB_USER="bskbd_new"
DB_PASSWORD="@Oviovih400"

# Security & Encryption Secrets (Change in Production)
KEY="bsk-directus-secure-guid-key-2026"
SECRET="bsk-directus-secure-signature-secret-2026"

# Initial Admin Credentials (Created automatically on first bootstrap)
ADMIN_EMAIL="admin@bskbd.org"
ADMIN_PASSWORD="bsk@2026"

# File Upload Storage (Stored in uploads folder inside directus)
STORAGE_LOCATIONS="local"
STORAGE_LOCAL_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads"

# CORS Configuration
CORS_ENABLED="true"
CORS_ORIGIN="https://bskbd.org,https://www.bskbd.org,http://localhost:3000"
CORS_METHODS="GET,POST,PATCH,DELETE,OPTIONS"
